EXPO_PUBLIC_API_BASE_URL="http://localhost:4000"
EXPO_PUBLIC_WEBAR_BASE_URL="http://localhost:5173"
# PWA only: the PIKE app's own origin — webar "Back to your wallet" returns here after
# an authenticated app-channel claim (http://localhost:8081 for `expo start` web).
EXPO_PUBLIC_APP_BASE_URL="http://localhost:8081"

# --- Expo Project ID (for push notifications) ---
# Get this from https://expo.dev after creating a project.
# Required for Expo push notifications (FR-6). Leave empty to disable native push.
EXPO_PUBLIC_PROJECT_ID=""
