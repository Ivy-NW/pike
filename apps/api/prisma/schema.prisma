// PIKE — Postgres schema (Neon). One database backs WebAR, App, Dashboard, and Admin.
// Migrations live in prisma/migrations — generated via `npx prisma migrate dev`, never hand-written SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  unverified
  verified
}

enum QuestStatus {
  draft
  live
  paused
}

enum RewardTier {
  low_stakes
  high_value
}

enum RewardType {
  discount
  merch
  vip_pass
  free_item
}

/// FR-12: which surface the reward was claimed from — webar (guest web claim) or app (authenticated in-app).
enum ClaimMethod {
  webar
  app
}

enum RedemptionStatus {
  claimed
  flagged
  rejected
}

enum MarkerStatus {
  pending_compile
  ready
  failed
}

/// On-chain attestation addendum (docs/PIKE_onchain_attestation_PRD.md), FR-A1-A7.
enum AttestationStatus {
  pending
  queued
  batched
  confirmed
  failed
}

enum BatchStatus {
  building
  submitting
  confirmed
  failed
}

model Business {
  id                    String        @id @default(uuid())
  name                  String
  email                 String        @unique
  passwordHash          String?
  emailVerificationToken String?      @unique
  paymentStatus         PaymentStatus @default(unverified)
  stripeCustomerId      String?
  stripePaymentMethodId String?
  createdByAdmin        Boolean       @default(false)
  emailVerified         Boolean       @default(false)
  suspended             Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  venues Venue[]

  @@map("businesses")
}

model Venue {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  venueType  String
  address    String?
  createdAt  DateTime @default(now())

  quests           Quest[]
  markers          Marker[]
  macroQuestVenues MacroQuestVenue[]

  @@index([businessId])
  @@map("venues")
}

model Quest {
  id                    String      @id @default(uuid())
  venueId               String
  venue                 Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name                  String
  theme                 String
  rewardType            RewardType
  rewardTier            RewardTier  @default(low_stakes)
  rewardDescription     String
  maxRedemptionsPerDay  Int         @default(50)
  expiresAt             DateTime?
  status                QuestStatus @default(draft)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  markers     Marker[]
  redemptions Redemption[]

  @@index([venueId])
  @@map("quests")
}

/// FR-11: each marker ties to exactly one venue + one quest.
model Marker {
  id                String       @id @default(uuid())
  questId           String
  quest             Quest        @relation(fields: [questId], references: [id], onDelete: Cascade)
  venueId           String
  venue             Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sourceImageUrl    String
  compiledTargetUrl String?
  /// The XR8.XrController.configure({imageTargetData}) entry for this marker — {imagePath, type, properties, metadata}.
  imageTargetData   Json?
  printAssetUrl     String?
  qrFallbackUrl     String
  status            MarkerStatus @default(pending_compile)
  createdAt         DateTime     @default(now())

  redemptions Redemption[]

  @@index([questId])
  @@index([venueId])
  @@map("markers")
}

/// FR-13: device/session signal logged on every completion, even before an account exists.
model Redemption {
  id           String            @id @default(uuid())
  markerId     String
  marker       Marker            @relation(fields: [markerId], references: [id], onDelete: Cascade)
  questId      String
  quest        Quest             @relation(fields: [questId], references: [id], onDelete: Cascade)
  venueId      String
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  claimMethod  ClaimMethod?
  status       RedemptionStatus  @default(claimed)
  sessionId    String
  userAgent    String
  ipHash       String
  flagReason   String?
  createdAt    DateTime          @default(now())

  /// On-chain attestation addendum, FR-A2: keccak256 of {id, markerId, venueId, questId,
  /// sessionId, userAgent, ipHash, createdAt}. Computed synchronously at row-creation time —
  /// see RedemptionsService.create() — so it is always set before the row is ever queued.
  attestationHash    String?
  attestationStatus  AttestationStatus @default(pending)
  attestationBatchId String?
  attestationBatch   AttestationBatch? @relation(fields: [attestationBatchId], references: [id])
  /// FR-A4: serialized merkletreejs proof, sufficient to verify this row's inclusion in its
  /// batch's on-chain root independently of the rest of the batch.
  merkleProof        Json?
  merkleLeafIndex    Int?

  @@index([questId, createdAt])
  @@index([venueId, questId, createdAt])
  @@index([sessionId])
  @@index([attestationStatus])
  @@index([attestationBatchId])
  @@map("redemptions")
}

/// On-chain attestation addendum, FR-A3/FR-A4/FR-A6: one row per Merkle-batch write to
/// Avalanche. Redemptions link back via Redemption.attestationBatchId.
model AttestationBatch {
  id            String      @id @default(uuid())
  status        BatchStatus @default(building)
  merkleRoot    String?
  itemCount     Int
  txHash        String?     @unique
  chainId       Int?
  gasUsed       BigInt?
  gasCostWei    BigInt?
  windowStartAt DateTime
  windowEndAt   DateTime?
  submittedAt   DateTime?
  confirmedAt   DateTime?
  retryCount    Int         @default(0)
  lastError     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  redemptions Redemption[]

  @@index([status])
  @@map("attestation_batches")
}

/// On-chain attestation addendum, FR-A3: batch window/threshold are admin-editable at
/// runtime (no deploy needed) — single-row table, id is always 1. Env vars only seed this
/// row's initial values on first migration; AttestationConfigService reads/caches this row.
model AttestationConfig {
  id                  Int      @id @default(1)
  batchWindowMs       Int
  batchCountThreshold Int
  maxRetries          Int      @default(5)
  updatedAt           DateTime @updatedAt

  @@map("attestation_config")
}

/// Consumer accounts. FR-1: same credential across WebAR claim and app install — our own
/// username/email/password auth, not a third-party identity provider.
model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  name                 String
  email                String    @unique
  phone                String    @unique
  passwordHash         String
  /// Phase 2 — FR-2: XP, level (derived), streak counter, badges.
  xp                   Int       @default(0)
  currentStreak        Int       @default(0)
  longestStreak        Int       @default(0)
  /// Date (not timestamp) of the last claimed redemption, used to compute streak continuation.
  lastQuestCompletedAt DateTime?
  createdAt            DateTime  @default(now())

  redemptions           Redemption[]
  badges                UserBadge[]
  macroQuestCompletions MacroQuestCompletion[]

  @@map("users")
}

/// Phase 2 — FR-2 earned badges. Badge definitions (criteria, name, description) live in code
/// (GamificationService), not the DB — this table just records which key a user has unlocked.
model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeKey])
  @@map("user_badges")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

/// Marketing-site admin code gate (obscurity layer only -- the real security boundary is
/// Admin's own email/password login via AdminAuthGuard). Every attempt is logged so repeated
/// failures are visible to admins even though the code itself isn't the trust boundary.
model AdminGateAttempt {
  id        String   @id @default(uuid())
  ipHash    String
  userAgent String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@map("admin_gate_attempts")
}

enum WaitlistAudience {
  consumer
  business
}

/// Captured from the landing page's "app not published yet" download CTA.
model WaitlistSignup {
  id        String           @id @default(uuid())
  email     String           @unique
  audience  WaitlistAudience
  createdAt DateTime         @default(now())

  @@map("waitlist_signups")
}

enum MacroQuestStatus {
  draft
  live
  ended
}

/// Phase 3 — FR-5: a multi-venue macro-quest. Visit `requiredVenues` of the participating venues
/// within [startsAt, endsAt] to unlock the largest reward tier. One live macro-quest at a time in v1.
/// Per-user progress is derived from redemptions at the participating venues, not stored — only the
/// terminal completion is recorded (MacroQuestCompletion), consistent with ADR 0005's award model.
model MacroQuest {
  id                String           @id @default(uuid())
  name              String
  description       String
  /// How many distinct participating venues a user must visit within the window to complete it.
  requiredVenues    Int
  rewardType        RewardType
  rewardDescription String
  rewardTier        RewardTier       @default(high_value)
  startsAt          DateTime
  endsAt            DateTime
  status            MacroQuestStatus @default(draft)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  venues      MacroQuestVenue[]
  completions MacroQuestCompletion[]

  @@index([status])
  @@map("macro_quests")
}

/// The set of venues that count toward a macro-quest (the "5 partner venues").
model MacroQuestVenue {
  id           String     @id @default(uuid())
  macroQuestId String
  macroQuest   MacroQuest @relation(fields: [macroQuestId], references: [id], onDelete: Cascade)
  venueId      String
  venue        Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([macroQuestId, venueId])
  @@index([macroQuestId])
  @@map("macro_quest_venues")
}

/// Terminal record that a user reached `requiredVenues` within the window. The unique constraint
/// makes the unlock idempotent (a repeat check never double-awards), per ADR 0005.
model MacroQuestCompletion {
  id           String     @id @default(uuid())
  macroQuestId String
  macroQuest   MacroQuest @relation(fields: [macroQuestId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt  DateTime   @default(now())

  @@unique([macroQuestId, userId])
  @@index([userId])
  @@map("macro_quest_completions")
}
