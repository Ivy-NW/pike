// PIKE — Postgres schema (Neon). One database backs WebAR, App, Dashboard, and Admin.
// Migrations live in prisma/migrations — generated via `npx prisma migrate dev`, never hand-written SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  unverified
  verified
}

enum QuestStatus {
  draft
  live
  paused
}

enum RewardTier {
  low_stakes
  high_value
}

enum RewardType {
  discount
  merch
  vip_pass
  free_item
}

/// FR-12: which surface the reward was claimed from — webar (guest web claim) or app (authenticated in-app).
enum ClaimMethod {
  webar
  app
}

enum RedemptionStatus {
  claimed
  flagged
  rejected
}

enum MarkerStatus {
  pending_compile
  ready
  failed
}

model Business {
  id                    String        @id @default(uuid())
  name                  String
  email                 String        @unique
  passwordHash          String?
  emailVerificationToken String?      @unique
  paymentStatus         PaymentStatus @default(unverified)
  stripeCustomerId      String?
  stripePaymentMethodId String?
  createdByAdmin        Boolean       @default(false)
  emailVerified         Boolean       @default(false)
  suspended             Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  venues Venue[]

  @@map("businesses")
}

model Venue {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  venueType  String
  address    String?
  createdAt  DateTime @default(now())

  quests  Quest[]
  markers Marker[]

  @@index([businessId])
  @@map("venues")
}

model Quest {
  id                    String      @id @default(uuid())
  venueId               String
  venue                 Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name                  String
  theme                 String
  rewardType            RewardType
  rewardTier            RewardTier  @default(low_stakes)
  rewardDescription     String
  maxRedemptionsPerDay  Int         @default(50)
  expiresAt             DateTime?
  status                QuestStatus @default(draft)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  markers     Marker[]
  redemptions Redemption[]

  @@index([venueId])
  @@map("quests")
}

/// FR-11: each marker ties to exactly one venue + one quest.
model Marker {
  id                String       @id @default(uuid())
  questId           String
  quest             Quest        @relation(fields: [questId], references: [id], onDelete: Cascade)
  venueId           String
  venue             Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sourceImageUrl    String
  compiledTargetUrl String?
  /// The XR8.XrController.configure({imageTargetData}) entry for this marker — {imagePath, type, properties, metadata}.
  imageTargetData   Json?
  printAssetUrl     String?
  qrFallbackUrl     String
  status            MarkerStatus @default(pending_compile)
  createdAt         DateTime     @default(now())

  redemptions Redemption[]

  @@index([questId])
  @@index([venueId])
  @@map("markers")
}

/// FR-13: device/session signal logged on every completion, even before an account exists.
model Redemption {
  id           String            @id @default(uuid())
  markerId     String
  marker       Marker            @relation(fields: [markerId], references: [id], onDelete: Cascade)
  questId      String
  quest        Quest             @relation(fields: [questId], references: [id], onDelete: Cascade)
  venueId      String
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  claimMethod  ClaimMethod?
  status       RedemptionStatus  @default(claimed)
  sessionId    String
  userAgent    String
  ipHash       String
  flagReason   String?
  createdAt    DateTime          @default(now())

  @@index([questId, createdAt])
  @@index([venueId, questId, createdAt])
  @@index([sessionId])
  @@map("redemptions")
}

/// Consumer accounts. FR-1: same credential across WebAR claim and app install — our own
/// username/email/password auth, not a third-party identity provider.
model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  name                 String
  email                String    @unique
  phone                String    @unique
  passwordHash         String
  /// Phase 2 — FR-2: XP, level (derived), streak counter, badges.
  xp                   Int       @default(0)
  currentStreak        Int       @default(0)
  longestStreak        Int       @default(0)
  /// Date (not timestamp) of the last claimed redemption, used to compute streak continuation.
  lastQuestCompletedAt DateTime?
  createdAt            DateTime  @default(now())

  redemptions Redemption[]
  badges      UserBadge[]

  @@map("users")
}

/// Phase 2 — FR-2 earned badges. Badge definitions (criteria, name, description) live in code
/// (GamificationService), not the DB — this table just records which key a user has unlocked.
model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeKey])
  @@map("user_badges")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

/// Marketing-site admin code gate (obscurity layer only -- the real security boundary is
/// Admin's own email/password login via AdminAuthGuard). Every attempt is logged so repeated
/// failures are visible to admins even though the code itself isn't the trust boundary.
model AdminGateAttempt {
  id        String   @id @default(uuid())
  ipHash    String
  userAgent String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@map("admin_gate_attempts")
}

enum WaitlistAudience {
  consumer
  business
}

/// Captured from the landing page's "app not published yet" download CTA.
model WaitlistSignup {
  id        String           @id @default(uuid())
  email     String           @unique
  audience  WaitlistAudience
  createdAt DateTime         @default(now())

  @@map("waitlist_signups")
}
