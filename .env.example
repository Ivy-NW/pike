# --- Postgres (Neon recommended per PRD 9.4) ---
DATABASE_URL="postgresql://user:password@localhost:5432/pike?schema=public"

# --- Redis (redemption-cap counters) ---
REDIS_URL="redis://localhost:6379"

# --- Firebase Auth (consumer phone/social + business email/password) ---
# TODO(credentials): create a Firebase project and fill these in.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Admin auth (separate from Firebase — seeded directly, see apps/api/scripts/seed-admin.ts) ---
ADMIN_SEED_EMAIL="ivynjoroge30@gmail.com"
ADMIN_SEED_PASSWORD="1234"
ADMIN_JWT_SECRET="change-me-in-production"
CONSUMER_JWT_SECRET="change-me-in-production"
BUSINESS_JWT_SECRET="change-me-in-production"

# --- Stripe (payment-method verification gate for quest publish) ---
# TODO(credentials): fill in once a Stripe account exists.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- 8th Wall ---
# No API key needed — 8th Wall went open source Feb 2026 (https://8thwall.org), no account
# or app key required. Marker compiling is done locally in MarkerCompileService via sharp.

# --- Push Notifications (FR-6) ---
# Web Push (PWA) — generate VAPID keys with `npx web-push generate-vapid-keys --json`.
# The public key is exposed to the PWA at GET /push/vapid-public-key so the browser can subscribe.
# Empty = PWA push disabled (stubbed).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Expo Push (native iOS/Android) — works immediately with no credentials required.
# The app obtains an Expo push token on launch and registers it via POST /users/me/push-token.
# To use Expo push, set EXPO_PUBLIC_PROJECT_ID in apps/app/.env (get from https://expo.dev).

# --- API ---
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"
WEBAR_BASE_URL="http://localhost:5173"

# --- On-chain attestation (Avalanche Fuji testnet for Phase A) — docs/PIKE_onchain_attestation_PRD.md, FR-A1..A7 ---
AVALANCHE_RPC_URL="https://api.avax-test.network/ext/bc/C/rpc"
AVALANCHE_CHAIN_ID="43113"                      # Fuji testnet; 43114 for C-Chain mainnet when promoted
ATTESTATION_CONTRACT_ADDRESS="0x86124ef07500b269449c953967516a1f75fd0323"
# TODO(credentials): backend-held service wallet key (FR-A7) — never exposed to any client,
# dashboard user, or venue owner; same handling/rotation bar as ADMIN_JWT_SECRET etc. today.
# KNOWN GAP: no secrets-manager integration exists in this repo yet (plain process.env for every
# secret) — not a special blockchain exception, just the same standing gap as other credentials.
# For Fuji (no real funds at risk), a fresh throwaway key generated locally is fine.
ATTESTATION_WALLET_PRIVATE_KEY=""

# --- Soulbound Token Layer (Phase C) — docs/PIKE_token_layer_PRD.md, FR-T1..T10 ---
# Token contracts deployed to Fuji (Phase B complete):
PIKE_ACHIEVEMENTS_ADDRESS="0x2292bcf86cdefa46d87af78ef6310bcedeb880e5"
PIKE_REWARD_VOUCHERS_ADDRESS="0x089b5e065d5912b77ea58bfce045d346500a9d3b"

# Custodial HD wallet mnemonic (FR-T7) — derives deterministic addresses per user.
# Generate with: node -e "console.log(require('@scure/bip39').generateMnemonic(require('@scure/bip39').wordlist))"
# Guard this like database credentials — it controls all user token addresses.
TOKEN_CUSTODIAL_MNEMONIC=""

# Service wallet for token minting/burning (can be same as ATTESTATION_WALLET_PRIVATE_KEY or separate).
# Separate keys limit blast radius; same key is simpler to fund and monitor (PRD section 12 open question).
TOKEN_WALLET_PRIVATE_KEY=""
# Seed values only — the live, admin-editable copy lives in the AttestationConfig table (FR-A3,
# see PATCH /admin/attestations/config). These just populate that row on first seed and serve
# as local-dev fallback if the row is somehow missing.
# --- Soulbound token layer (docs/PIKE_token_layer_PRD.md, ADR 0007) ---
# Filled in after `npm run deploy:tokens:fuji --workspace packages/contracts`. Both contracts
# are owned by the same service wallet as the attestation registry unless a separate key is
# introduced (PRD section 12, still open). Unset until phase B is deployed; phase C wiring
# should treat an empty address as "token layer disabled" and skip minting entirely, the same
# way payments treats a missing STRIPE_SECRET_KEY.
ACHIEVEMENTS_CONTRACT_ADDRESS=""
REWARD_VOUCHERS_CONTRACT_ADDRESS=""
# TODO(credentials): backend-held HD seed for deterministic per-user custodial addresses
# (FR-T7/FR-T9). Never exposed to any client. Same rotation bar and same standing
# secrets-manager gap as ATTESTATION_WALLET_PRIVATE_KEY above.
TOKEN_CUSTODY_SEED=""

ATTESTATION_BATCH_WINDOW_MS="300000"            # 5 minutes
ATTESTATION_BATCH_COUNT_THRESHOLD="500"
ATTESTATION_MAX_RETRIES="5"
